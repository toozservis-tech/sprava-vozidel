# =============================================================================
# Správa vozidel – Environment Variables
# =============================================================================
#
# INSTRUKCE:
# 1. Zkopírujte tento soubor jako .env
# 2. Vyplňte skutečné hodnoty (NIKDY necommitujte .env do gitu)
# 3. Lokální dev běh funguje i bez produkčních tajemství
#
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000
# Volitelné: síťové rozhraní pro Uvicorn (prázdné = jako HOST). Pro přístup z telefonu v LAN k PC: 0.0.0.0 a v prohlížeči http://<místní-IP-PC>:PORT
# Na serveru za Cloudflare obvykle nechte prázdné nebo 127.0.0.1.
LISTEN_HOST=
ENVIRONMENT=development
PRODUCTION_LOCK_MODE=false

# =============================================================================
# DATABASE
# =============================================================================
# Canonical runtime default bez nastavení ENV:
# sqlite:////Users/.../source-mirror/data/vehicles.db
# Nastavte pouze pokud chcete runtime DB výslovně přepsat.
DATABASE_URL=
# Legacy compat alias. Pokud je vyplněný současně s DATABASE_URL, hlavní prioritu má DATABASE_URL.
VEHICLE_DB_URL=
TEST_DATABASE_URL=sqlite:///./test_vehicles.db
# Volitelné: přepište pouze pokud nechcete používat default ./data nebo lokální fallback ./.local_data
DATA_DIR_PATH=

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET_KEY=sprava-vozidel-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Preferované: interní base URL backendu (pro odkazy v e-mailech / některé helpery).
SPRAVA_VOZIDEL_API_URL=
# Deprecated alias (stále podporováno): TOOZHUB_API_URL
# TOOZHUB_API_URL=
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:8000
TEST_API_URL=http://127.0.0.1:8000

# =============================================================================
# FAKTURYWEB API
# =============================================================================
# Export vystavených servisních faktur do https://www.fakturyweb.cz/api/nf
FAKTURYWEB_API_BASE_URL=https://www.fakturyweb.cz
FAKTURYWEB_EMAIL=
FAKTURYWEB_API_KEY=
# Volitelné: ID dodavatele z FakturyWeb "Moje společnosti". Pokud není vyplněno,
# použijí se fakturační údaje servisního účtu.
FAKTURYWEB_SUPPLIER_ID=
# V developmentu doporučeno true; FakturyWeb test faktury smaže po 5-10 minutách.
FAKTURYWEB_API_TEST=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
ALLOWED_ORIGINS=*

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
SMTP_HOST=smtp.mail.webnode.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=info@toozservis.cz
# Webnode: typicky 465 (SSL) nebo 587 (STARTTLS). Někteří hostitelé blokují odchozí 465 z VPS — pak použijte 587.
# Notifikace o nových registracích (CSV seznam emailů)
REGISTRATION_ALERT_EMAILS=developer@example.com,admin@example.com
# Alternativní single-email fallback pro developera
DEVELOPER_ALERT_EMAIL=
# Cílový email pro zprávy z panelu "Kontaktovat podporu"
SUPPORT_EMAIL=info@toozservis.cz

# =============================================================================
# VIN PREVIEW: katalogové fotky vozidel
# =============================================================================
# disabled | mock | searchapi | serpapi
VEHICLE_IMAGE_PROVIDER=disabled
VEHICLE_IMAGE_API_KEY=
# Alias, pokud chcete držet tajný klíč pod jiným názvem:
VEHICLE_IMAGE_API_SECRET=
VEHICLE_IMAGE_SEARCH_ENDPOINT=
VEHICLE_IMAGE_CACHE_TTL_DAYS=180
VEHICLE_IMAGE_MAX_RESULTS=6
VEHICLE_IMAGE_ALLOWED_COLORS=white,grey
VEHICLE_IMAGE_MIN_WIDTH=600
VEHICLE_IMAGE_MIN_HEIGHT=350
# SerpApi engine: google_images | yandex_images
VEHICLE_IMAGE_SERPAPI_ENGINE=yandex_images
VEHICLE_IMAGE_SERPAPI_ENDPOINT=https://serpapi.com/search.json
VEHICLE_IMAGE_SERPAPI_YANDEX_DOMAIN=yandex.com
VEHICLE_IMAGE_SERPAPI_YANDEX_ORIENTATION=horizontal
VEHICLE_IMAGE_SERPAPI_YANDEX_IMAGE_TYPE=photo
VEHICLE_IMAGE_SERPAPI_YANDEX_FAMILY_MODE=1
VEHICLE_IMAGE_REGEN_LIMIT_ENABLED=true

# =============================================================================
# DATAOVOZIDLECH.CZ API
# =============================================================================
DATAOVO_API_KEY=your-api-key-here
DATAOVO_API_BASE_URL=https://api.dataovozidlech.cz/api/vehicletechnicaldata/v2

# =============================================================================
# AUTOPILOT M2M API
# =============================================================================
AUTOPILOT_SHARED_SECRET=your-shared-secret-here

# =============================================================================
# WEB PUSH NOTIFICATIONS
# =============================================================================
# Zapne/vypne web push vrstvu (subscription API + odesílání push)
WEB_PUSH_ENABLED=1
# VAPID klíče vygenerujte např. přes pywebpush script (public + private key)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identifikace odesílatele (mailto:... nebo URL)
VAPID_CLAIMS_SUBJECT=mailto:info@toozservis.cz
# Interní serverový worker pro periodickou kontrolu připomínek
ENABLE_REMINDER_NOTIFICATION_WORKER=1
REMINDER_NOTIFICATION_WORKER_INTERVAL_SEC=300

# Worker pro lifecycle předplatného (obnovy, grace, upozornění)
ENABLE_LICENSE_SUBSCRIPTION_WORKER=1
LICENSE_SUBSCRIPTION_WORKER_INTERVAL_SEC=3600

# Periodický import otevřených dat MDČR (STK/SME → lokální DB u známých VIN v aplikaci)
# Stejný tok jako Developerský POST /admin-api/mdcr-open-data/import (bez limitu, dry_run=vypnuto pokud nedáte níže TEST).
ENABLE_MDCR_OPEN_DATA_SCHEDULE_WORKER=1
# Čas dalšího běhu dle hodinek Prahy (hodina 0–23, minuty 0–59)
MDCR_SCHEDULE_HOUR_PRAGUE=3
MDCR_SCHEDULE_MINUTE_PRAGUE=30
# 1 = jen simulace, nezapisuje do DB (pro ladění)
MDCR_SCHEDULE_DRY_RUN=0
# Volitelně e-mail vývojáře z DB – záznam DeveloperActionAuditLog (stejně jako ruční import)
MDCR_SCHEDULE_AUDIT_EMAIL=

# =============================================================================
# FEATURE FLAGS (MVP SCOPE)
# =============================================================================
# Production defaults in code:
# - ENABLE_AI_FEATURES=false
# - ENABLE_CUSTOMER_COMMANDS=false
# - ENABLE_AUTOPILOT_API=true
ENABLE_AI_FEATURES=false
ENABLE_CUSTOMER_COMMANDS=false
ENABLE_AUTOPILOT_API=true

# =============================================================================
# LICENSE / ADMIN
# =============================================================================
# Preferované názvy (fáze 2 rename). Prázdné = vypnuto.
SPRAVA_VOZIDEL_ADMIN_TENANT_ID=
SPRAVA_VOZIDEL_ADMIN_FORCE_PREMIUM=0
# Deprecated aliasy (stále podporovány dokud neodstraníte fáze 3):
# TOOZHUB_ADMIN_TENANT_ID=
# TOOZHUB_ADMIN_FORCE_PREMIUM=0
# Tenant ID, který může měnit plán licence přes /api/v1/license/upgrade.

# =============================================================================
# COMGATE PAYMENT GATEWAY (LICENCE UPGRADE)
# =============================================================================
# 1=true -> zapne Comgate checkout flow v /api/v1/license/comgate/*
COMGATE_ENABLED=0
# Merchant ID z Comgate administrace
COMGATE_MERCHANT=
# Secret z Comgate administrace
COMGATE_SECRET=
# Test mode (doporučeno při prvním nasazení)
COMGATE_TEST_MODE=1
# API endpointy (obvykle není potřeba měnit)
COMGATE_CREATE_URL=https://payments.comgate.cz/v1.0/create
COMGATE_STATUS_URL=https://payments.comgate.cz/v1.0/status
# Recurring endpoint pro automatické obnovy
COMGATE_RECURRING_URL=https://payments.comgate.cz/v1.0/recurring
COMGATE_RECURRING_ENABLED=1
# Výchozí měna/jazyk/metoda
COMGATE_CURRENCY=CZK
COMGATE_METHOD=ALL
# Metoda pro subscription checkout (doporučeno pouze karta)
COMGATE_SUBSCRIPTION_METHOD=CARD
# Test fallback: pokud merchant nemá povolený recurring, v test módu povolí jednorázový checkout
COMGATE_TEST_ONE_TIME_FALLBACK=1
COMGATE_COUNTRY=CZ
COMGATE_LANG=cs
# Ceny licencí v haléřích
# Basic 99 Kč / měsíc, Premium 299 Kč / měsíc
COMGATE_PRICE_BASIC_HALERS=9900
COMGATE_PRICE_PREMIUM_HALERS=29900
# Roční ceny (10x měsíční cena = sleva 2 měsíce)
COMGATE_PRICE_BASIC_YEARLY_HALERS=99000
COMGATE_PRICE_PREMIUM_YEARLY_HALERS=299000
# Grace po selhání obnovy (dny)
COMGATE_SUBSCRIPTION_GRACE_DAYS=7
# Notifikace před koncem předplatného
COMGATE_SUBSCRIPTION_NOTIFY_DAYS=14,7,1

# =============================================================================
# SECURITY TRACKING (Developer Admin - IP/lokalita)
# =============================================================================
# 1=true -> pri loginu uklada IP a pribliznou lokalitu do security_access_logs
# 0=false -> uklada pouze IP bez geo lookupu
ENABLE_IP_GEOLOOKUP=1

# Timeout pro geo lookup (sekundy)
IP_GEOLOOKUP_TIMEOUT_SEC=1.2

# Provider URL (placeholder {ip} je nahrazen klientskou IP)
IP_GEOLOOKUP_PROVIDER_URL=https://ipwho.is/{ip}

# Minimalni interval (v sekundach) mezi zapisy heartbeat aktivity jednoho uzivatele
USER_ACTIVITY_LOG_MIN_INTERVAL_SEC=90

# Velikost in-memory cache pro throttling heartbeat zapisu
USER_ACTIVITY_CACHE_MAX_ITEMS=5000

# Blokovani pokusu o stazeni backend zdrojaku/konfigurace z HTTP cest
ENABLE_SOURCE_PROTECTION=1

# Volitelne e-mailove upozorneni pri zablokovanem source-probe pokusu
# Vyuziva SECURITY_ALERT_EMAILS, pripadne DEVELOPER_ALERT_EMAIL / REGISTRATION_ALERT_EMAILS
ENABLE_SOURCE_PROTECTION_EMAIL_ALERTS=0
SECURITY_ALERT_EMAILS=
SOURCE_PROTECTION_ALERT_THROTTLE_SEC=900

# Okno online stavu v adminu (v sekundach), napr. 300 = 5 minut
ADMIN_USER_ONLINE_WINDOW_SEC=300

# =============================================================================
# UKÁZKOVÝ ÚČET (demo)
# =============================================================================
# 1) Vygenerujte účet a data: python3 scripts/seed_demo_account.py
#    (vyžaduje SPRAVA_VOZIDEL_DEMO_ACCOUNT_EMAIL + SPRAVA_VOZIDEL_DEMO_ACCOUNT_PASSWORD)
# 2) Veřejná ukázka: návštěvník zadá e-mail + souhlas → přijde mu jednorázový odkaz (náhodný token v e-mailu).
#    Odkaz otevře /web/demo.html — relace (JWT) se vytvoří jen ze stejné IP jako při žádosti o odkaz; staré e-maily přes /web/demo-access.html se přesměrují
#    Každý odkaz je jednorázový a vázaný na IP při žádosti. Vyžaduje funkční SMTP.
#    Audit: GET /admin-api/demo-access-leads (jen developer_admin) — tabulka demo_access_tokens.
SPRAVA_VOZIDEL_PUBLIC_DEMO_CREDENTIALS=0
# SPRAVA_VOZIDEL_DEMO_ACCOUNT_EMAIL=demo@example.com
# SPRAVA_VOZIDEL_DEMO_ACCOUNT_PASSWORD=change-me-demo-only
# Platnost odkazu v e-mailu (hodiny), výchozí 24
# SPRAVA_VOZIDEL_DEMO_LINK_TTL_HOURS=24
# Volitelné limity (za hodinu): příliš mnoho pokusů z jedné IP / na jeden kontaktní e-mail → HTTP 429
# SPRAVA_VOZIDEL_DEMO_ACCESS_MAX_PER_IP_HOUR=24
# SPRAVA_VOZIDEL_DEMO_ACCESS_MAX_PER_EMAIL_HOUR=8
# Zastaralé aliasy: TOOZHUB_PUBLIC_DEMO_CREDENTIALS, TOOZHUB_DEMO_ACCOUNT_EMAIL, TOOZHUB_DEMO_ACCOUNT_PASSWORD

# =============================================================================
# PRODUKČNÍ ZABEZPEČENÍ (doporučeno)
# =============================================================================
# Vynutit přesměrování HTTP -> HTTPS (za Nginx/Cloudflare s X-Forwarded-Proto).
# Health /health/* zůstává dostupné i přes HTTP pro interní sondy.
ENFORCE_HTTPS=0

# CSV povolených sítí pro /admin-api, /web_admin, /admin-static (IPv4/IPv6, volitelně CIDR).
# Příklad: ADMIN_NETWORK_ALLOWLIST=203.0.113.10,198.51.100.0/24,2001:db8::/32
# Prázdné = bez IP filtru (zpětná kompatibilita). Vyžaduje správné předání klientovy IP z proxy.
ADMIN_NETWORK_ALLOWLIST=

# Společný limit všech požadavků na /admin-api za minutu na jednu IP (brání hrubé enumeraci).
ADMIN_API_RATE_LIMIT_PER_MIN=90

# -----------------------------------------------------------------------------
# Cloudflare Zero Trust Access (doporučeno místo denního přepisu veřejné IP)
# -----------------------------------------------------------------------------
# Zapne ověření JWT hlavičky Cf-Access-Jwt-Assertion na /web_admin, /admin-api,
# /admin-static. V Cloudflare vytvořte Self-hosted aplikaci pro tyto cesty + politiku jen pro váš e-mail.
# TEAM_DOMAIN najdete jako URL issueru v Zero Trust → Settings (https://váš.cloudflareaccess.com).
# AUDIENCE = Application Audience tag u aplikace → Additional settings.
# CLOUDFLARE_ACCESS_ALLOWED_EMAILS= prázdné = jakýkoli uživatel, kterého Access pustí (JWT musí platit).
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCESS_PROTECT_ADMIN=0
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://muj-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=zde-vlozte-aud-tag-z-dashboardu
# Volitelná druhá vrstva jen pro váás (shodný e-mail jako v Access politice):
# CLOUDFLARE_ACCESS_ALLOWED_EMAILS=vaemail@firma.cz

# Přihlášení do /web_admin/, role developer_admin pro Control Center — viz deploy/PRODUCTION_ACCESS.txt
